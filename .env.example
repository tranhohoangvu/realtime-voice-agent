# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# LLM Configuration (Choose 'groq' or 'gemini')
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# STT Configuration ('faster-whisper' for 100% local CPU)
STT_PROVIDER=faster-whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS Configuration ('edge-tts' for free cloud or 'kokoro' for local)
TTS_PROVIDER=edge-tts
TTS_VOICE_EN=en-US-EmmaNeural
TTS_VOICE_VI=vi-VN-HoaiMyNeural

# VAD Settings
VAD_CONFIDENCE_THRESHOLD=0.5
SILENCE_DURATION_MS=500
